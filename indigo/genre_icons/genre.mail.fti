#	Genre icon: Mail (envelope)
#	ORIGINAL work of the Indigo-Magic-on-Linux project
#	(indigo-appsync genre set) -- our copyright, freely
#	redistributable. No SGI icon geometry is copied or traced;
#	only the SGI .fti icon *language* (shadow+iconcolor+outline)
#	is shared.  Canvas 0..100, y-up.

#	shadow
		color(shadowcolor);
		bgnpolygon();
			vertex(17.50, 17.50);
			vertex(89.50, 17.50);
			vertex(89.50, 65.50);
			vertex(17.50, 65.50);
		endpolygon();

#	envelope body
		color(iconcolor);
		bgnoutlinepolygon();
			vertex(14.00, 22.00);
			vertex(86.00, 22.00);
			vertex(86.00, 70.00);
			vertex(14.00, 70.00);
		endoutlinepolygon(outlinecolor);

#	flap (V from top corners to centre)
		color(outlinecolor);
		bgnline();
			vertex(14.00, 70.00);
			vertex(50.00, 44.00);
			vertex(86.00, 70.00);
		endline();

#	side creases
		color(outlinecolor);
		bgnline();
			vertex(14.00, 22.00);
			vertex(40.00, 46.00);
			vertex(14.00, 70.00);
		endline();

		color(outlinecolor);
		bgnline();
			vertex(86.00, 22.00);
			vertex(60.00, 46.00);
			vertex(86.00, 70.00);
		endline();

#	stamp (blue accent square)
		color(4);
		bgnpolygon();
			vertex(70.00, 74.00);
			vertex(84.00, 74.00);
			vertex(84.00, 88.00);
			vertex(70.00, 88.00);
		endpolygon();

		color(iconcolor);
		bgnoutlinepolygon();
			vertex(70.00, 74.00);
			vertex(84.00, 74.00);
			vertex(84.00, 88.00);
			vertex(70.00, 88.00);
		endoutlinepolygon(outlinecolor);
