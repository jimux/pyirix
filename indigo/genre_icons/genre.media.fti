			vertex(81.09, 18.49);
			vertex(83.88, 19.91);
			vertex(86.09, 22.12);
			vertex(87.51, 24.91);
			vertex(88.00, 28.00);
			vertex(88.00, 72.00);
			vertex(87.51, 75.09);
			vertex(86.09, 77.88);
			vertex(83.88, 80.09);
			vertex(81.09, 81.51);
			vertex(78.00, 82.00);
