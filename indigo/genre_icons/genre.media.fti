#	play triangle (white)
		color(7);
		bgnpolygon();
			vertex(40.00, 32.00);
			vertex(40.00, 68.00);
			vertex(70.00, 50.00);
		endpolygon();

		color(7);
		bgnoutlinepolygon();
			vertex(40.00, 32.00);
			vertex(40.00, 68.00);
			vertex(70.00, 50.00);
		endoutlinepolygon(outlinecolor);

#	note stem + head accent (blue)
		color(outlinecolor);
		bgnline();
			vertex(26.00, 60.00);
			vertex(26.00, 34.00);
		endline();

		color(4);
		bgnpolygon();
			vertex(29.00, 32.00);
			vertex(28.33, 34.50);
			vertex(26.50, 36.33);
			vertex(24.00, 37.00);
			vertex(21.50, 36.33);
