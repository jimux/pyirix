#	Genre icon: Media (play + note)
#	ORIGINAL work of the Indigo-Magic-on-Linux project
#	(indigo-appsync genre set) -- our copyright, freely
#	redistributable. No SGI icon geometry is copied or traced;
#	only the SGI .fti icon *language* (shadow+iconcolor+outline)
#	is shared.  Canvas 0..100, y-up.

#	shadow
		color(shadowcolor);
		bgnpolygon();
			vertex(15.50, 23.50);
			vertex(15.99, 20.41);
			vertex(17.41, 17.62);
