#	rounded screen
		color(iconcolor);
		bgnoutlinepolygon();
			vertex(12.00, 28.00);
			vertex(12.49, 24.91);
			vertex(13.91, 22.12);
			vertex(16.12, 19.91);
			vertex(18.91, 18.49);
