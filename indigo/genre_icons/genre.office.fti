#	Genre icon: Office (document)
#	ORIGINAL work of the Indigo-Magic-on-Linux project
#	(indigo-appsync genre set) -- our copyright, freely
#	redistributable. No SGI icon geometry is copied or traced;
#	only the SGI .fti icon *language* (shadow+iconcolor+outline)
#	is shared.  Canvas 0..100, y-up.

#	shadow
		color(shadowcolor);
		bgnpolygon();
			vertex(27.50, 5.50);
			vertex(67.50, 5.50);
			vertex(79.50, 21.50);
			vertex(79.50, 85.50);
			vertex(27.50, 85.50);
		endpolygon();

#	page
		color(iconcolor);
		bgnoutlinepolygon();
			vertex(24.00, 10.00);
			vertex(64.00, 10.00);
			vertex(76.00, 26.00);
			vertex(76.00, 90.00);
			vertex(24.00, 90.00);
		endoutlinepolygon(outlinecolor);

#	folded corner
		color(outlinecolor);
		bgnline();
			vertex(64.00, 10.00);
			vertex(64.00, 26.00);
			vertex(76.00, 26.00);
		endline();

#	text lines
		color(outlinecolor);
		bgnline();
			vertex(32.00, 78.00);
			vertex(68.00, 78.00);
		endline();

		color(outlinecolor);
		bgnline();
			vertex(32.00, 70.00);
			vertex(68.00, 70.00);
		endline();

		color(outlinecolor);
		bgnline();
			vertex(32.00, 62.00);
			vertex(68.00, 62.00);
		endline();

		color(outlinecolor);
		bgnline();
			vertex(32.00, 54.00);
			vertex(68.00, 54.00);
		endline();

		color(outlinecolor);
		bgnline();
			vertex(32.00, 46.00);
			vertex(68.00, 46.00);
		endline();

		color(outlinecolor);
		bgnline();
			vertex(32.00, 38.00);
			vertex(68.00, 38.00);
		endline();

		color(outlinecolor);
		bgnline();
			vertex(32.00, 30.00);
			vertex(68.00, 30.00);
		endline();
