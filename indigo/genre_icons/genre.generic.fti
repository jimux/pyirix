#	spark / starburst (yellow, 4-point)
		color(3);
		bgnpolygon();
			vertex(50.00, 80.00);
			vertex(57.00, 57.00);
			vertex(80.00, 50.00);
			vertex(57.00, 43.00);
			vertex(50.00, 20.00);
			vertex(43.00, 43.00);
			vertex(20.00, 50.00);
			vertex(43.00, 57.00);
		endpolygon();

		color(3);
		bgnoutlinepolygon();
			vertex(50.00, 80.00);
			vertex(57.00, 57.00);
			vertex(80.00, 50.00);
			vertex(57.00, 43.00);
			vertex(50.00, 20.00);
			vertex(43.00, 43.00);
			vertex(20.00, 50.00);
			vertex(43.00, 57.00);
		endoutlinepolygon(outlinecolor);

