#	app tile
		color(iconcolor);
		bgnoutlinepolygon();
			vertex(16.00, 30.00);
			vertex(16.69, 25.67);
			vertex(18.67, 21.77);
			vertex(21.77, 18.67);
			vertex(25.67, 16.69);
